# Bite 35.6 canonical 1Password owner-unavailable recovery locator manifest.
# Locator names are required planned item identities, NOT proof that the vault
# contains the items or that a second human has access. Keep Production blocked
# until external custody review and real isolated restore acceptance.
# This file contains locator metadata only. NEVER place credentials or secret values here.
RECOVERY_ACCESS_FORMAT_VERSION=1
RECOVERY_OWNER_UNAVAILABLE_REQUIRED=true
RECOVERY_SHARED_SECRETS_PROVIDER=1Password
RECOVERY_SHARED_COLLECTION=ers-production
RECOVERY_REPOSITORY_SLUG=RodrigoMattosoSilveira/EnterpriseRemoteSystems
RECOVERY_REPOSITORY_URL=git@github.com:RodrigoMattosoSilveira/EnterpriseRemoteSystems.git
RECOVERY_REPOSITORY_SOURCE=github://RodrigoMattosoSilveira/EnterpriseRemoteSystems
RECOVERY_PRODUCTION_ENV_SOURCE=op://ers-production/recovery-production-env/document
RECOVERY_S3_CREDENTIAL_SOURCE=op://ers-production/recovery-hetzner-s3/document
RECOVERY_HOST_ACCESS_SOURCE=op://ers-production/recovery-host-ssh/document
RECOVERY_HETZNER_CONSOLE_SOURCE=op://ers-production/recovery-hetzner-console/document
RECOVERY_DNS_SOURCE=op://ers-production/recovery-dns/document
RECOVERY_MFA_RECOVERY_SOURCE=technician-controlled://independent-mfa-and-recovery-codes
RECOVERY_EDGE_SOURCE=github://RodrigoMattosoSilveira/EnterpriseRemoteSystems/edge
RECOVERY_REPOSITORY_INSTALL_PATH=/opt/EnterpriseRemoteSystems/production
RECOVERY_PRODUCTION_ENV_INSTALL_PATH=/opt/EnterpriseRemoteSystems/production/.env.production
RECOVERY_S3_CREDENTIAL_INSTALL_PATH=/opt/EnterpriseRemoteSystems/secrets/aws-credentials
RECOVERY_EDGE_INSTALL_PATH=/opt/EnterpriseRemoteSystems/edge
RECOVERY_PRODUCTION_DOMAIN=app.enterpriseremotesystems.com
RECOVERY_DNS_DOMAIN=enterpriseremotesystems.com
RECOVERY_S3_ENDPOINT=https://hel1.your-objectstorage.com
RECOVERY_S3_REGION=hel1
RECOVERY_S3_BUCKET=ers
RECOVERY_S3_PROFILE=ers-backup
RECOVERY_SHARED_ACCESS_POLICY=technician-access-independent-of-owner
RECOVERY_MFA_POLICY=must-not-depend-on-owner-device-or-approval
