APP_ENV=production
HTTP_PORT=8080
DB_DRIVER=sqlite
DB_DSN=./db.sqlite3
JWT_SECRET=your_jwt_secret_here
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Required to enable immutable ledger reverse/replace endpoints. Store as a secret.
LEDGER_CORRECTION_KEY=replace-with-a-long-random-secret
# Required to enable authorized zero-gold settlement operations. Store as a secret.
LEDGER_SETTLEMENT_KEY=replace-with-a-different-long-random-secret
# Optional controlled authorization bootstrap. Disabled by default.
# Enable only to create or repair a persisted administrator. Request headers identify
# the actor; effective permissions always come from persisted role grants.
AUTHZ_BOOTSTRAP_ENABLED=false
AUTHZ_BOOTSTRAP_ACTOR_KEY=
AUTHZ_BOOTSTRAP_DISPLAY_NAME=
AUTHZ_BOOTSTRAP_ROLE_CODE=APPLICATION_ADMIN
AUTHZ_BOOTSTRAP_TENANT_ID=*
AUTHZ_BOOTSTRAP_REQUIRE_EMPTY_ACTOR_TABLE=false

# Bite 28C actor-header compatibility: disabled for normal traffic; bootstrap
# permits only AUTHZ_BOOTSTRAP_ACTOR_KEY; test permits isolated test actors.
AUTHZ_ACTOR_HEADER_MODE=disabled

# Bite 28B server-side authentication sessions.
AUTH_SESSION_TTL_MINUTES=720
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_PASSWORD_HASH_COST=12
AUTH_SESSION_COOKIE_NAME=ers_session
AUTH_SESSION_COOKIE_SAME_SITE=Lax
AUTH_SESSION_COOKIE_SECURE=true
