APP_ENV=development
HTTP_PORT=8080
DB_DRIVER=sqlite
DB_DSN=./db.sqlite3
JWT_SECRET=your_jwt_secret_here
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Bite 28B server-side authentication sessions.
AUTH_SESSION_TTL_MINUTES=720
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_PASSWORD_HASH_COST=12
AUTH_SESSION_COOKIE_NAME=ers_session
AUTH_SESSION_COOKIE_SAME_SITE=Lax
AUTH_SESSION_COOKIE_SECURE=false
