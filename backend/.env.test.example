APP_ENV=test
HTTP_PORT=8080
DB_DRIVER=sqlite
DB_DSN=./db.sqlite3
JWT_SECRET=your_jwt_secret_here
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Required to enable immutable ledger reverse/replace endpoints. Store as a secret.
LEDGER_CORRECTION_KEY=replace-with-a-long-random-secret
# Required to enable authorized zero-gold settlement operations. Store as a secret.
LEDGER_SETTLEMENT_KEY=replace-with-a-different-long-random-secret
